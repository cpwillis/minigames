{
  "name": "minigames",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--localstorage-file=/tmp/minigames-dev-storage.json' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:types && npm run test:unit && npm run test:migrations && npm run test:api",
    "test:unit": "node --test 'tests/unit.test.ts' 'tests/secret.test.ts' 'tests/contract.test.mjs'",
    "test:api": "node --test tests/api.test.mjs",
    "test:migrations": "node --test tests/migrations.test.mjs",
    "test:types": "tsc --noEmit && cd api && tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
